# Copy to .env and adjust. Bun loads .env automatically, and every value below is optional:
# a missing one takes the default shown here.
#
# This file is the whole configuration surface; src/helpers/config.ts reads it once, at startup.

NODE_ENV=development
PORT=3000

# When true, every failed request is appended to debug.txt at the project root.
# The HTTP response stays sanitized either way.
DEBUG=false
# Where DEBUG=true writes. The test suite points this outside the repository.
DEBUG_FILE=debug.txt

# Browser
# false opens a visible browser window, reusing the same profile: use it to look at what a page
# really renders with the `browser` driver. It is a debugging mode, not an anti-bot measure.
GOOGLE_HEADLESS=true
# Navigation timeout (ms) applied to every page Puppeteer creates.
PUPPETEER_TIMEOUT=30000
# Required when Chromium runs as root inside a container (Docker, Kubernetes).
PUPPETEER_NO_SANDBOX=false
# The Chromium/Chrome binary to drive. Empty uses the one Puppeteer resolved (its own download,
# or the system package when the image sets PUPPETEER_EXECUTABLE_PATH).
PUPPETEER_EXECUTABLE_PATH=
# The browser's locale, used for --lang and Accept-Language.
GOOGLE_LOCALE=en-US
# Empty means the browser's own User-Agent. Set it only when a specific one is required.
GOOGLE_USER_AGENT=

# Search backend
# The base URL of the website search backend. The current implementation is SearXNG, and the API
# reaches it over HTTP only; nothing in src/ knows anything else about it. Inside Docker this is
# overridden with http://searxng:8080 (the Compose service name).
SEARXNG_URL=http://localhost:18080
# Host port for SearXNG's own interface, mapped to 8080 inside the container. Read by Docker
# Compose, not by the API.
SEARXNG_PORT=18080
# HTTP timeout for the search backend request (ms).
SEARCH_TIMEOUT=30000
# SearXNG's server.secret_key; generate one with `openssl rand -hex 32`. Read by Docker Compose,
# not by the API.
SEARXNG_SECRET=
# The public base URL SearXNG uses for the links on its own pages. Read by Docker Compose, not
# by the API.
SEARXNG_BASE_URL=http://localhost:18080/
# Profile directory, reused between runs so cookies, local storage and any consent choice survive
# restarts.
GOOGLE_PROFILE_DIR=.cache/google
# Maximum value accepted for the `limit` field on /website/search, and the default when the
# caller does not send one.
MAX_RESULTS=10

# Response cache
# Where a successful response is cached: "redis" uses REDIS_URL (overridden to
# redis://redis:6379 by docker-compose.yml), "memory" keeps entries in this process, and
# "none" disables caching. A missing, empty or misspelled value means "none".
CACHE_DRIVER=none
# Only read when CACHE_DRIVER=redis. Empty means there is nothing to connect to, which
# turns the cache off instead of failing the request.
REDIS_URL=redis://localhost:6379

# Webpage extraction
# Timeout (ms) for the page fetch itself: the Axios request, the redirect probe and the browser
# navigation. PUPPETEER_TIMEOUT above is the default timeout applied to a page's operations.
PAGE_LOAD_TIMEOUT=30000
# Upper bound for the extracted `content` string (characters). Longer content is truncated
# with a `[content truncated]` marker.
MAX_CONTENT_LENGTH=120000

# API documentation
# When true, the OpenAPI document and Swagger UI are served at /docs (as JSON at
# /docs/openapi.json). Off by default: the docs are a development aid, not part of the
# public API surface, and a disabled instance does not register the route at all.
SWAGGER_ENABLED=false

# MCP
# When true, an MCP server is served at /mcp by this same process and port, on top of the
# same search and page services the REST API uses. It exposes two tools, website_search and
# website_fetch. Off by default: a missing, empty or misspelled value leaves it off, exactly
# like every other boolean setting, so an instance without MCP_ENABLED behaves as it always did.
MCP_ENABLED=false
