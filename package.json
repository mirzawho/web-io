{
  "name": "web-io",
  "version": "1.0.0",
  "description": "Website search and web content API over HTTP: search the web, fetch pages, extract metadata and AI-readable Markdown",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir out"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "fastest-validator": "^1.19.1",
    "puppeteer": "^25.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "domhandler": "^5.0.3",
    "typescript": "^7.0.2"
  }
}
